# Copy to .env and fill in real values. Never commit the filled-in file.
# See docs/DEPLOYMENT.md for what each variable does.

# Supabase project (required for login and saved papers)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<publishable anon key>

# Supabase JWT secret (recommended). Enables fast local HS256 token
# verification. If unset, the backend verifies tokens against the
# Supabase Auth API on every call instead.
SUPABASE_JWT_SECRET=

# Real email address. Unpaywall rejects requests without one.
UNPAYWALL_EMAIL=you@example.com

# Exact frontend origins allowed to call the API, as a JSON list.
# Example for production: ["https://research.example.com"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Ollama (local LLM). Default port is 11434; a manual serve may use 11435.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional paper-source keys. Without them the source still works but
# with tighter rate limits, except CORE which returns nothing.
CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex API key (free, one per email). Without it, requests draw on
# the shared-IP daily budget, which is often used up. While the key is
# pending activation, requests with it get 403 key_not_activated and
# the backend retries once without the key, so the app keeps working.
OPENALEX_API_KEY=

# Optional: persistent chat sessions. Without these, sessions live in
# memory and clear on backend restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limits per IP (defaults shown).
RATE_LIMIT_SUMMARIZE_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_DRAFT_PER_HOUR=2
