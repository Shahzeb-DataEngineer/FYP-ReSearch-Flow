# Copy to .env and fill in real values. Never commit the filled-in file.
# In Docker, VITE_API_URL defaults to /api/v1 and nginx proxies it to
# the backend, so only the two Supabase values are needed there.

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable anon key>

# Local dev only: point the Vite dev server at the backend directly.
# Leave unset in Docker.
VITE_API_URL=http://localhost:8000/api/v1
