# Repo-root environment file for Docker Compose.
# Copy to .env and fill in real values, then run:
#   docker compose up --build
# Never commit the filled-in file. Compose interpolates ${VAR} from
# .env into docker-compose.yml; the backend image never copies a .env
# file, so a variable missing from docker-compose.yml never reaches
# the app. backend/.env and frontend/.env are the same values split
# per service for the manual (non-Docker) run; see those .env.example
# files. Only the variables below are read by Compose.

# Backend Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=
CORE_API_KEY=your_core_api_key_here
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=

# Pinecone vector store for RAG chat (Starter free tier, no credit
# card). Required for ask-about-paper; without it RAG chat answers
# "Pinecone is not configured". The backend creates the index itself
# on first use (serverless, AWS us-east-1, 768 dim, cosine). Starter
# runs on AWS us-east-1 only, so leave the cloud and region as below.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=research-flow
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Zotero import (free API, read-only). Both needed to sync a library.
ZOTERO_API_KEY=
ZOTERO_USER_ID=

# Optional: persistent chat sessions (Upstash Redis). Without these,
# sessions live in memory and clear on backend restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local LLM - Ollama (zero cost, no API key)
# Install Ollama from https://ollama.com, then:
#   ollama pull qwen2.5:3b
#   ollama pull nomic-embed-text
# On a 16 GB laptop qwen2.5:7b also works (set OLLAMA_CHAT_MODEL).
# Ollama's default port is 11434. If you run a manual serve on
# another port (for example 11435), set OLLAMA_BASE_URL to match.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192

# Rate limits per IP (defaults shown).
RATE_LIMIT_SUMMARIZE_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_DRAFT_PER_HOUR=2

# CORS - locked down to local frontend origins by default.
# Override with a comma-separated list to add a deployed frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Unpaywall (free, DOI-based open-access lookup) needs a real contact
# email address. Unpaywall rejects example.com addresses with HTTP 422,
# so replace the placeholder with a real project address.
UNPAYWALL_EMAIL=your-email@example.com

# Optional shared key for state-changing backend routes
# (DELETE /chat/history). When unset, local dev stays open. When set,
# requests need a matching X-API-Key header. Never commit a real key.
# BACKEND_API_KEY=<redacted>

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Frontend Configuration (for reference)
VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Removed (paid, no longer used):
# - OPENAI_API_KEY / OPENROUTER_API_KEY: replaced by local Ollama
# - SERPAPI_API_KEY: Google Scholar via SerpAPI removed (paid).
#   Crossref and Europe PMC were added as free replacements.
