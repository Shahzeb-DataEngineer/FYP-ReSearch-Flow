# Backend Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
CORE_API_KEY=your_core_api_key_here

# Local LLM - Ollama (zero cost, no API key)
# Install Ollama from https://ollama.com, then:
#   ollama pull qwen2.5:7b
#   ollama pull nomic-embed-text
# On a low-RAM machine use qwen2.5:3b instead of qwen2.5:7b.
# Ollama's default port is 11434. If you run a manual serve on
# another port (for example 11435), set OLLAMA_BASE_URL to match.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192

# CORS - locked down to local frontend origins by default.
# Override with a comma-separated list to add a deployed frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional shared key for state-changing backend routes
# (DELETE /chat/history). When unset, local dev stays open. When set,
# requests need a matching X-API-Key header. Never commit a real key.
# BACKEND_API_KEY=<redacted>

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Frontend Configuration (for reference)
VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Removed (paid, no longer used):
# - OPENAI_API_KEY / OPENROUTER_API_KEY: replaced by local Ollama
# - PINECONE_API_KEY / PINECONE_INDEX_NAME: replaced by local FAISS
# - SERPAPI_API_KEY: Google Scholar via SerpAPI removed (paid).
#   Crossref and Europe PMC were added as free replacements.
